---
layout: base.njk
---

<header class="max-w-6xl mx-auto mb-4 px-4">
    <h1 class="text-3xl font-extrabold">
        <a href="{{ link or '/' }}" class="text-brand hover:text-brand-dark transition-colors">
            {{ title or eleventyNavigation.title }}
        </a>
    </h1>
</header>
<div class="max-w-6xl mx-auto px-4 flex flex-col gap-4 md:grid md:grid-cols-[280px_1fr] md:gap-8 items-start">
    <nav class="sidebar w-full bg-card rounded-cu p-4 border border-border-line shadow-cu-sm">
        {{ collections.all | eleventyNavigation | eleventyNavigationToHtml({ activeKey: eleventyNavigation.key, activeAnchorClass: "active bg-red-100 text-brand-dark font-bold hover:bg-red-200", activeListItemClass: "active-list-item", useAriaCurrentAttr: true }) | safe }}
    </nav>
    <div class="content prose w-full min-w-0 bg-card rounded-cu p-6 md:p-8 border border-border-line shadow-cu-lg">
        {% if eleventyNavigation and eleventyNavigation.parent %}
        <nav class="breadcrumb text-sm mb-6">
        {{ collections.all | eleventyNavigationBreadcrumb(eleventyNavigation.parent, {includeSelf: true}) | eleventyNavigationToHtml | safe }}
        </nav> 
        {% endif %}
        {{ content | safe }}
        <div class="nextprev mt-12 pt-8 border-t border-border-line flex flex-col gap-4 sm:flex-row sm:justify-between sm:items-center">
            {%- set nextPost = collections.notes | sortByPageOrder | getNextCollectionItem(page) %}
            {%- if nextPost %}
                <p class="next m-0 text-sm font-bold text-slate flex items-center gap-2 sm:ml-auto">Next:
                    <a href="{{ nextPost.url }}" class="inline-flex items-center px-5 py-2.5 bg-card border border-border-line rounded-full text-brand shadow-cu-sm font-bold hover:bg-red-50 hover:border-brand hover:text-brand-dark hover:-translate-y-0.5 hover:shadow-md transition-all active:translate-y-0">{{ nextPost.data.title }}</a>
                </p>
            {% endif %}
            {%- set previousPost = collections.notes | sortByPageOrder | getPreviousCollectionItem(page) %}
            {%- if previousPost %}
                <p class="previous m-0 text-sm font-bold text-slate flex items-center gap-2">Previous:
                    <a href="{{ previousPost.url }}" class="inline-flex items-center px-5 py-2.5 bg-card border border-border-line rounded-full text-brand shadow-cu-sm font-bold hover:bg-red-50 hover:border-brand hover:text-brand-dark hover:-translate-y-0.5 hover:shadow-md transition-all active:translate-y-0">{{ previousPost.data.title }}</a>
                </p>
            {% endif %}
        </div>
        <div class="comments mt-12 pt-8 border-t border-border-line">
            <script src="https://utteranc.es/client.js" repo="{{ metadata.commentsRepo }}" issue-term="title" theme="github-light" crossorigin="anonymous" async></script>
        </div>
    </div>
</div>
<!-- Image Gallery Lightbox Overlay -->
<dialog id="gallery-lightbox" class="gallery-dialog" aria-label="Enlarged Image View">
    <div class="gallery-dialog-shell">
        <button type="button" class="gallery-dialog-close" aria-label="Close enlarged view">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>
        <button type="button" class="gallery-dialog-nav gallery-dialog-prev" aria-label="Previous image">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
        </button>
        <button type="button" class="gallery-dialog-nav gallery-dialog-next" aria-label="Next image">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
        </button>
        <div class="gallery-dialog-content">
            <div class="gallery-dialog-media"></div>
            <div class="gallery-dialog-caption"></div>
        </div>
    </div>
</dialog>

<script>
    document.querySelectorAll('.answer-block').forEach(d => {
        d.addEventListener('click', (e) => {
            d
                .querySelector('.feedback')
                .classList
                .toggle('hidden');
            d.classList.toggle('selected');
        });
    });
    const urlParams = new URLSearchParams(window.location.search);
    const embed = urlParams.get('embed');
    const print = urlParams.get('print');
    if (embed || print) {
        document.querySelectorAll('.comments').forEach(d => {
            d.classList.toggle('hidden');
        });
        document.querySelectorAll('.sidebar').forEach(d => {
            d.classList.toggle('hidden');
        });
        document.querySelectorAll('.breadcrumb').forEach(d => {
            d.classList.toggle('hidden');
        });
        document.querySelectorAll('.nextprev').forEach(d => {
            d.classList.toggle('hidden');
        });
    }
    if(print) {
        document.querySelectorAll('.panoptoembed').forEach(d => {
            d.classList.toggle('hidden');
        });
    }

    // Initialize interactive image galleries & lightbox
    function initGalleries() {
        const lightbox = document.getElementById('gallery-lightbox');
        const dialogMedia = lightbox ? lightbox.querySelector('.gallery-dialog-media') : null;
        const dialogCaption = lightbox ? lightbox.querySelector('.gallery-dialog-caption') : null;
        const dialogClose = lightbox ? lightbox.querySelector('.gallery-dialog-close') : null;
        const dialogPrev = lightbox ? lightbox.querySelector('.gallery-dialog-prev') : null;
        const dialogNext = lightbox ? lightbox.querySelector('.gallery-dialog-next') : null;

        let activeGallery = null;
        let activeSlideIndex = 0;

        function openLightboxMedia(picOrImg, captionHtml = '') {
            // Clone picture or img for display in lightbox
            const clone = picOrImg.cloneNode(true);

            // Update sizes attribute to let browser use high-res source in modal
            clone.querySelectorAll('source').forEach(s => s.setAttribute('sizes', '90vw'));
            if (clone.tagName === 'IMG') {
                clone.setAttribute('sizes', '90vw');
            } else {
                const img = clone.querySelector('img');
                if (img) img.setAttribute('sizes', '90vw');
            }

            dialogMedia.innerHTML = '';
            dialogMedia.appendChild(clone);

            if (captionHtml && captionHtml.trim().length > 0) {
                dialogCaption.innerHTML = captionHtml;
                dialogCaption.style.display = 'block';
            } else {
                dialogCaption.innerHTML = '';
                dialogCaption.style.display = 'none';
            }

            if (!lightbox.open) {
                lightbox.showModal();
                document.body.classList.add('lightbox-open');
            }
        }

        function showLightboxSlide(gallery, index) {
            if (!lightbox || !gallery) return;
            const slides = gallery.querySelectorAll('.gallery-slide');
            if (index < 0 || index >= slides.length) return;

            activeGallery = gallery;
            activeSlideIndex = index;

            const slide = slides[index];
            const figure = slide.querySelector('figure, .figure');
            if (!figure) return;

            const picOrImg = figure.querySelector('picture, img');
            if (!picOrImg) return;

            const figcaption = figure.querySelector('figcaption, .figure-caption');
            const captionHtml = (figcaption && figcaption.textContent.trim().length > 0) ? figcaption.innerHTML : '';

            // Update prev/next button states
            if (slides.length <= 1) {
                if (dialogPrev) dialogPrev.style.display = 'none';
                if (dialogNext) dialogNext.style.display = 'none';
            } else {
                if (dialogPrev) {
                    dialogPrev.style.display = 'flex';
                    dialogPrev.disabled = activeSlideIndex === 0;
                }
                if (dialogNext) {
                    dialogNext.style.display = 'flex';
                    dialogNext.disabled = activeSlideIndex === slides.length - 1;
                }
            }

            openLightboxMedia(picOrImg, captionHtml);
        }

        function showLightboxSingle(figureOrImg) {
            if (!lightbox || !figureOrImg) return;
            activeGallery = null;

            if (dialogPrev) dialogPrev.style.display = 'none';
            if (dialogNext) dialogNext.style.display = 'none';

            let picOrImg = null;
            let captionHtml = '';

            if (figureOrImg.tagName === 'FIGURE' || figureOrImg.classList.contains('figure')) {
                picOrImg = figureOrImg.querySelector('picture, img');
                const figcaption = figureOrImg.querySelector('figcaption, .figure-caption');
                if (figcaption && figcaption.textContent.trim().length > 0) {
                    captionHtml = figcaption.innerHTML;
                }
            } else if (figureOrImg.tagName === 'IMG' || figureOrImg.tagName === 'PICTURE') {
                picOrImg = figureOrImg;
                if (figureOrImg.getAttribute('alt')) {
                    captionHtml = figureOrImg.getAttribute('alt');
                }
            }

            if (!picOrImg) return;
            openLightboxMedia(picOrImg, captionHtml);
        }

        function closeLightbox() {
            if (lightbox && lightbox.open) {
                lightbox.close();
                document.body.classList.remove('lightbox-open');
                if (dialogMedia) dialogMedia.innerHTML = '';
                activeGallery = null;
            }
        }

        if (lightbox) {
            if (dialogClose) {
                dialogClose.addEventListener('click', closeLightbox);
            }

            // Light dismiss: click outside the media/shell closes modal
            lightbox.addEventListener('click', (e) => {
                if (e.target === lightbox || e.target.classList.contains('gallery-dialog-shell')) {
                    closeLightbox();
                }
            });

            lightbox.addEventListener('close', () => {
                document.body.classList.remove('lightbox-open');
                if (dialogMedia) dialogMedia.innerHTML = '';
                activeGallery = null;
            });

            if (dialogPrev) {
                dialogPrev.addEventListener('click', (e) => {
                    e.stopPropagation();
                    if (activeGallery && activeSlideIndex > 0) {
                        showLightboxSlide(activeGallery, activeSlideIndex - 1);
                    }
                });
            }

            if (dialogNext) {
                dialogNext.addEventListener('click', (e) => {
                    e.stopPropagation();
                    if (activeGallery) {
                        const slides = activeGallery.querySelectorAll('.gallery-slide');
                        if (activeSlideIndex < slides.length - 1) {
                            showLightboxSlide(activeGallery, activeSlideIndex + 1);
                        }
                    }
                });
            }

            lightbox.addEventListener('keydown', (e) => {
                if (e.key === 'ArrowLeft' && activeGallery && activeSlideIndex > 0) {
                    e.preventDefault();
                    showLightboxSlide(activeGallery, activeSlideIndex - 1);
                } else if (e.key === 'ArrowRight' && activeGallery) {
                    const slides = activeGallery.querySelectorAll('.gallery-slide');
                    if (activeSlideIndex < slides.length - 1) {
                        e.preventDefault();
                        showLightboxSlide(activeGallery, activeSlideIndex + 1);
                    }
                }
            });
        }

        // Bind click handlers to standalone images/figures outside of galleries
        document.querySelectorAll('.prose figure, .prose .figure, .prose p > img, .prose > img').forEach(el => {
            if (el.closest('.gallery')) return;

            const picOrImg = (el.tagName === 'IMG' || el.tagName === 'PICTURE') ? el : el.querySelector('picture, img');
            if (!picOrImg) return;

            el.classList.add('lightbox-trigger');
            el.setAttribute('title', 'Click to enlarge');
            el.setAttribute('role', 'button');
            el.setAttribute('tabindex', '0');
            el.setAttribute('aria-haspopup', 'dialog');

            function triggerOpen(e) {
                if (e.target.closest('a')) return;
                showLightboxSingle(el);
            }

            el.addEventListener('click', triggerOpen);
            el.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    triggerOpen(e);
                }
            });
        });

        document.querySelectorAll('.gallery').forEach(gallery => {
            const track = gallery.querySelector('.gallery-track');
            if (!track) return;

            const slides = gallery.querySelectorAll('.gallery-slide');
            const prevBtn = gallery.querySelector('.gallery-prev');
            const nextBtn = gallery.querySelector('.gallery-next');
            const dots = gallery.querySelectorAll('.gallery-dot');
            const currentSpan = gallery.querySelector('.gallery-current');
            const totalSlides = slides.length;

            // Bind click handlers to images/figures in each slide for lightbox overlay
            slides.forEach((slide, slideIndex) => {
                const figure = slide.querySelector('figure, .figure');
                if (!figure) return;

                figure.classList.add('lightbox-trigger', 'gallery-lightbox-trigger');
                figure.setAttribute('title', 'Click to enlarge');
                figure.setAttribute('role', 'button');
                figure.setAttribute('tabindex', '0');
                figure.setAttribute('aria-haspopup', 'dialog');

                function triggerOpen(e) {
                    // Don't trigger if clicked on a link inside figcaption
                    if (e.target.closest('a')) return;
                    showLightboxSlide(gallery, slideIndex);
                }

                figure.addEventListener('click', triggerOpen);
                figure.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter' || e.key === ' ') {
                        e.preventDefault();
                        triggerOpen(e);
                    }
                });
            });

            if (totalSlides <= 1) {
                if (prevBtn) prevBtn.style.display = 'none';
                if (nextBtn) nextBtn.style.display = 'none';
                const dotsContainer = gallery.querySelector('.gallery-dots');
                if (dotsContainer) dotsContainer.style.display = 'none';
                return;
            }

            let currentIndex = 0;

            function closeAccordions() {
                gallery.querySelectorAll('details[open]').forEach(d => {
                    d.removeAttribute('open');
                });
            }

            function updateState(index) {
                if (index < 0) index = 0;
                if (index >= totalSlides) index = totalSlides - 1;
                currentIndex = index;

                if (currentSpan) currentSpan.textContent = currentIndex + 1;
                if (prevBtn) prevBtn.disabled = currentIndex === 0;
                if (nextBtn) nextBtn.disabled = currentIndex === totalSlides - 1;

                dots.forEach((dot, i) => {
                    const isActive = i === currentIndex;
                    dot.setAttribute('aria-selected', isActive ? 'true' : 'false');
                    if (isActive) {
                        dot.classList.add('active');
                    } else {
                        dot.classList.remove('active');
                    }
                });
            }

            function scrollToSlide(index) {
                if (index < 0 || index >= totalSlides) return;
                if (index !== currentIndex) {
                    closeAccordions();
                }
                const targetSlide = slides[index];
                if (targetSlide) {
                    targetSlide.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
                }
                updateState(index);
            }

            if (prevBtn) {
                prevBtn.addEventListener('click', () => {
                    scrollToSlide(currentIndex - 1);
                });
            }

            if (nextBtn) {
                nextBtn.addEventListener('click', () => {
                    scrollToSlide(currentIndex + 1);
                });
            }

            dots.forEach((dot, i) => {
                dot.addEventListener('click', () => {
                    scrollToSlide(i);
                });
            });

            track.addEventListener('keydown', (e) => {
                if (e.key === 'ArrowLeft') {
                    e.preventDefault();
                    scrollToSlide(currentIndex - 1);
                } else if (e.key === 'ArrowRight') {
                    e.preventDefault();
                    scrollToSlide(currentIndex + 1);
                }
            });

            let scrollTimeout;
            track.addEventListener('scroll', () => {
                clearTimeout(scrollTimeout);
                scrollTimeout = setTimeout(() => {
                    const trackLeft = track.getBoundingClientRect().left;
                    let closestIndex = 0;
                    let minDiff = Infinity;
                    slides.forEach((slide, i) => {
                        const diff = Math.abs(slide.getBoundingClientRect().left - trackLeft);
                        if (diff < minDiff) {
                            minDiff = diff;
                            closestIndex = i;
                        }
                    });
                    if (closestIndex !== currentIndex) {
                        closeAccordions();
                    }
                    updateState(closestIndex);
                }, 50);
            }, { passive: true });

            updateState(0);
        });
    }

    initGalleries();
</script>